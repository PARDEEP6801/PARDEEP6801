# ─── AI Studio API keys ───
# Apni key "=" ke baad paste karo (quotes ki zaroorat nahi), save karo, phir `npm run dev`.
# Ye file kabhi kisi ko share mat karna / GitHub pe mat daalna.

# NVIDIA: https://build.nvidia.com -> login -> koi bhi model kholo -> "Get API Key" (nvapi-... se shuru hoti hai)
NVIDIA_API_KEY=

# OpenRouter (optional): https://openrouter.ai/keys  (sk-or-... se shuru hoti hai)
OPENROUTER_API_KEY=

# Server settings (optional)
PORT=8000
